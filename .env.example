# Passcode required to use the app. Set something real before deploying.
APP_PIN=1234

# Secret used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=dev-secret-change-me

# Absolute base URL embedded in every printed QR code.
# MUST be final before printing labels - changing it invalidates printed QRs.
# For phone testing against a dev server, use your LAN IP: http://192.168.x.x:3000
BASE_URL=http://localhost:3000

DB_PATH=./data/storage.sqlite
PORT=3000
